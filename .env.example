# Copy this file to .env and fill in your real values. Never commit .env itself.

# NVIDIA NIM — get a key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# OpenRouter — get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama — local, no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Redis (Upstash or local docker-compose redis)
REDIS_URL=redis://localhost:6379/0

# Rate limiting defaults (per "team" — you'll define what a team is)
DEFAULT_REQUESTS_PER_MINUTE=20
DEFAULT_TOKENS_PER_MINUTE=20000

# Circuit breaker defaults
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
